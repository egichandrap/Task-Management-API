# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_PORT=8080

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=task_api
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret
